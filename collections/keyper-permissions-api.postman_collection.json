      "name": "Permissions",
      "description": {
        "content": "Retrieve the permission whitelist / blacklist for an Access Control System.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "07c3de18-6dba-404c-84ff-7022f3950a6d",
          "name": "Get permissions (Whitelist / Blacklist)",
          "request": {
            "name": "Get permissions (Whitelist / Blacklist)",
            "description": {
              "content": "Get permission entries an Access Control System should use to set ticket permissions (Grant / Block). Poll incrementally using lastID set to the last successfully retrieved permission entry.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "permissions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lastID",
                  "value": "<long>",
                  "description": "(Required) Last ID of permissions fetched by the ACS."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "50",
                  "description": "Count of permissions to be returned (max. 500)."
                },
                {
                  "disabled": false,
                  "key": "suppressMetadata",
                  "value": "false",
                  "description": "Set whether metadata is included."
                },
                {
                  "disabled": false,
                  "key": "permissionID",
                  "value": "<string>",
                  "description": "Filter for a specific permission id."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional language preference list; defaults to English.",
                "key": "Accept-Language",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Optional version of the app the user is using.",
                "key": "X-App-Version",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
